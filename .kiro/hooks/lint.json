{
  "name": "lint-on-save",
  "description": "Run flake8 whenever a Python file is saved in the workspace.",
  "enabled": true,
  "trigger": {
    "event": "file_save",
    "glob": "**/*.py"
  },
  "action": {
    "type": "shell",
    "command": "flake8 .",
    "working_directory": "${workspaceFolder}",
    "timeout_seconds": 60
  }
}
